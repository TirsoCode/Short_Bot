# Database
DATABASE_URL=file:./data/shortbot.db

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-random-secret

# YouTube OAuth (create at console.cloud.google.com)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# GitHub
GITHUB_TOKEN=

# OpenCode Zen (https://opencode.ai/zen) - genera los hooks de YouTube con IA
# Modelo por defecto: big-pickle (gratis en OpenCode Zen)
OPENCODE_ZEN_API_KEY=
# Opcional: override del modelo o endpoint
# OPENCODE_ZEN_MODEL=big-pickle
# OPENCODE_ZEN_ENDPOINT=https://opencode.ai/zen/v1/chat/completions

# Cuántos shorts genera el bot al día (por defecto 2)
SHORTS_PER_DAY=2
# Máximo de hooks que se generan de golpe con Zen cuando se acaban (por defecto 100)
# HOOK_POOL_TARGET=100