# Database (la app guarda la DB en el directorio temporal del sistema)
DATABASE_URL=file:./data/shortbot.db

# Login de la app (dashboard). Genera un secreto fuerte y ponlo aquí
# (o como variable de entorno / GitHub secret en producción)
LOGIN_PASSWORD=change-me-a-long-random-secret

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-random-secret

# YouTube OAuth (create at console.cloud.google.com)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# GitHub (opcional: solo si vas a seguir importando medios desde GitHub)
GITHUB_TOKEN=

# OpenCode Zen (opcional pero recomendado): el bot genera hooks/títulos con IA
# y ajusta el estilo del vídeo con lenguaje natural. Crea tu API key en https://opencode.ai/zen
# Modelo por defecto de OpenCode Zen
OPENCODE_ZEN_API_KEY=
# Modelo por defecto: big-pickle (gratis en OpenCode Zen)
OPENCODE_ZEN_MODEL=big-pickle
# Opcional: override del endpoint
# OPENCODE_ZEN_ENDPOINT=https://opencode.ai/zen/v1/chat/completions

# Cuántos shorts genera el bot al día (por defecto 2)
SHORTS_PER_DAY=2
# Máximo de hooks que se generan de golpe con Zen cuando se acaban (por defecto 100)
# HOOK_POOL_TARGET=100